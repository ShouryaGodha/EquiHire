# =============================================================================
# EQUIHIRE CONFIGURATION
# Copy this file to .env and modify as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Qdrant Vector Database Configuration
# -----------------------------------------------------------------------------
# For local Docker: localhost:6333
# For Qdrant Cloud: your-cluster-url.qdrant.io
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=  # Required for Qdrant Cloud, leave empty for local

# Collection names (change if you want separate environments)
CANDIDATE_CHUNKS_COLLECTION=candidate_chunks
RECRUITER_MEMORY_COLLECTION=recruiter_memory

# -----------------------------------------------------------------------------
# Embedding Model Configuration
# -----------------------------------------------------------------------------
# Primary embedding model (sentence-transformers)
# Options: all-MiniLM-L6-v2 (384-dim, fast), all-mpnet-base-v2 (768-dim, better)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Cross-encoder for reranking (more accurate but slower)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
DEFAULT_TOP_K=20
CHUNK_SIZE=512        # Max characters per resume chunk
CHUNK_OVERLAP=50      # Overlap between chunks for context

# -----------------------------------------------------------------------------
# Scoring Weights (must sum to 1.0)
# -----------------------------------------------------------------------------
WEIGHT_SEMANTIC=0.4       # Vector similarity
WEIGHT_SKILLS=0.25        # Skill match
WEIGHT_EXPERIENCE=0.15    # Experience fit
WEIGHT_ROLE=0.1           # Role category match
WEIGHT_AVAILABILITY=0.05  # Location/remote fit
WEIGHT_FEEDBACK=0.05      # Recruiter feedback (placeholder)

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
DEBUG=true
LOG_LEVEL=INFO

# Data directory (relative to backend/)
DATA_DIR=./data/resumes

# -----------------------------------------------------------------------------
# Optional: OpenAI API (if using OpenAI embeddings instead)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

